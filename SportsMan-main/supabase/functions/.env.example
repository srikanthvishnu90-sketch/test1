# Copy this file to  supabase/functions/.env  and paste your real keys there.
# NEVER commit real keys — .env is gitignored; this .example is the template.
# These are SERVER secrets: they only ever live in a function's environment
# (local .env here, or Supabase → Edge Functions → Secrets in production).

# AI-Chat (Claude proxy)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embeddings (generate-embedding / backfill-embeddings)
# Provider switch — "openai" (default) or "voyage" (stub, TODO).
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if/when EMBEDDING_PROVIDER=voyage:
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
