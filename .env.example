# plumb — optional keys. Everything runs with in-memory adapters and NO keys.
# Copy to .env.local (gitignored) and fill in only what you actually use.

# Database (Postgres) — enables the pg-backed adapter instead of in-memory
# DATABASE_URL=

# LLM — the language capability is LABOR, not judgment; zero-LLM must always work
# LLM_API_KEY=

# Email
# EMAIL_API_KEY=
